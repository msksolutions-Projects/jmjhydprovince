# Copy to .env and adjust.

# Live website address (used for Google sitemap, link previews and canonical URLs)
VITE_SITE_URL=https://jmjhyderabadprovince.org

# API address. Leave empty when the backend serves this website (recommended),
# or set it when the API is hosted elsewhere, e.g. https://jmj-api.onrender.com/api/v1
VITE_API_BASE_URL=

# Where `npm run dev` / `npm run preview` forward /api requests
VITE_API_PROXY=http://localhost:5000

# Optional: WhatsApp chat button (international format, digits only, e.g. 919876543210)
VITE_WHATSAPP_NUMBER=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_ID=
