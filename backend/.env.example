# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jmj_hyderabad

# JWT
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Frontend URLs allowed to call the API (CORS). Add more, comma-separated, in CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://jmjprovincehyd.vercel.app
CORS_ORIGINS=

# Public address of this API, used for links to locally stored uploads (optional)
PUBLIC_API_URL=

# Cloudinary (recommended in production). Leave as-is to store uploads in backend/uploads/
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Admin Setup (for first time registration)
ADMIN_EMAIL=admin@jmjhyderabad.org
ADMIN_PASSWORD=initial_password_change_after_login

# Email notifications for the contact form (optional). Gmail needs an App Password.
# Messages are always saved in the admin Messages inbox, even without email.
CONTACT_TO=jmjhyd@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# AWS Configuration (optional, if using S3 instead of Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=ap-south-1

# Logging
LOG_LEVEL=info
